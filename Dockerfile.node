# Hosted ChatGPT / OpenAI Ads MCP (Python, Streamable HTTP)
# For Render / any PaaS: Language = Docker, Root Directory = (empty)

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TRANSPORT=http \
    MCP_STATELESS_HTTP=true \
    OPENAI_ADS_MCP_READONLY=1 \
    HOST=0.0.0.0 \
    PORT=8000

WORKDIR /app

COPY python/pyproject.toml python/README.md ./
COPY python/src ./src
COPY LICENSE ./LICENSE

RUN pip install --no-cache-dir .

EXPOSE 8000
CMD ["python", "-m", "openai_ads_mcp"]
