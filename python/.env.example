# === OpenAI Ads / ChatGPT Ads API ===
# Create a key in Ads Manager → Settings → API keys
# https://ads.openai.com/settings
# Not the same as platform.openai.com model API keys.
OPENAI_ADS_API_KEY=your_openai_ads_api_key_here

# Optional HTTPS override for tests or proxies
# OPENAI_ADS_API_BASE_URL=https://api.ads.openai.com/v1

# Read-only is the DEFAULT (write/spend tools are hidden).
# Leave as-is for stats-only. You do not need to set this for read-only.
OPENAI_ADS_MCP_READONLY=1

# --- Future: enable campaign create/update/activate via MCP ---
# Uncomment ONE of these and restart the server:
# OPENAI_ADS_MCP_ALLOW_WRITES=1
# OPENAI_ADS_MCP_READONLY=0
#
# Budget guard for create/update tools (USD). Default 100.
# OPENAI_ADS_BUDGET_CEILING_USD=100

# === Transport ===
# stdio -> local clients (Claude Desktop, Cursor). Default.
# http  -> hosted Streamable HTTP at /mcp. Recommended for custom MCP clients
#          behind Render/Railway/Fly. Requires MCP_BEARER_TOKEN.
# sse   -> legacy SSE at /sse. Only if your client needs it.
MCP_TRANSPORT=stdio

# === Hosted-mode auth (required when MCP_TRANSPORT=http or sse) ===
# Generate a strong token, then paste it here (do not commit the real value):
#   openssl rand -hex 32
# MCP_BEARER_TOKEN=
# Alias also accepted: OPENAI_ADS_MCP_HTTP_TOKEN

# === Streamable HTTP tuning (MCP_TRANSPORT=http) ===
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=false
# MCP_HTTP_PATH=/mcp

# === Networking (hosted mode) ===
PORT=8000
HOST=0.0.0.0

# === DNS-rebinding protection (optional) ===
# Leave empty to disable host checking (bearer token already guards the endpoint).
# MCP_ALLOWED_HOSTS=your-app.onrender.com,localhost:*
# MCP_ALLOWED_ORIGINS=https://your-app.onrender.com
